# ============================================================================
# Multi-Source Web Research Agent — environment configuration
# Copy this file to .env and fill in real values. NEVER commit a real .env.
# ============================================================================

# --- Application ------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ------------------------------------------------------------
# SQLite for local development (no setup required).
# For production, use PostgreSQL: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./researchlens.db

# --- CORS ---------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- LLM provider -------------------------------------------------------
# One of: groq | gemini | mock
# "mock" runs the full pipeline with a deterministic, offline placeholder
# synthesizer — useful for trying the project with zero credentials, but it
# is NOT a real LLM integration. Use groq or gemini for real synthesis.
LLM_PROVIDER=mock
# Groq model names change over time; verify available models at
# https://console.groq.com (e.g. "openai/gpt-oss-20b" is a current fast default).
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Search provider A: DuckDuckGo (no API key required) -------------------
DDG_ENABLED=true

# --- Search provider B: Tavily (requires an API key) ------------------------
# Get a free-tier key at https://tavily.com/
TAVILY_ENABLED=true
TAVILY_API_KEY=

# --- Retrieval / pipeline tuning -----------------------------------------
MAX_SUBQUERIES=4
MAX_RESULTS_PER_PROVIDER=8
MAX_SOURCES_TO_FETCH=8
FETCH_TIMEOUT_SECONDS=10
RETRIEVAL_CONCURRENCY=4
FETCH_CONCURRENCY=4

# --- Reliability ----------------------------------------------------------
PROVIDER_MAX_RETRIES=2
PROVIDER_BACKOFF_BASE_SECONDS=0.5
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RESET_SECONDS=30

# --- Security -------------------------------------------------------------
MAX_QUESTION_LENGTH=1000
MAX_REQUEST_BODY_BYTES=20000
ALLOW_PRIVATE_NETWORK_FETCH=false
